                          ] .


###  http://www.semanticweb.org/maria/ontologies/2026/4/untitled-ontology-3#CIUTAT
:CIUTAT rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :conte ;
                          owl:someValuesFrom :ATRACCIO
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :ofereix ;
                          owl:someValuesFrom :ALLOTJAMENT
                        ] .


###  http://www.semanticweb.org/maria/ontologies/2026/4/untitled-ontology-3#TRANSPORT
:TRANSPORT rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
