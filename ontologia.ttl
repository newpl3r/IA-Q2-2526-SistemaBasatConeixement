###  http://www.semanticweb.org/maria/ontologies/2026/4/untitled-ontology-3#ALLOTJAMENT
:ALLOTJAMENT rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :ciutat_allotjament ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :CIUTAT
                             ] .


###  http://www.semanticweb.org/maria/ontologies/2026/4/untitled-ontology-3#ATRACCIO
:ATRACCIO rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
