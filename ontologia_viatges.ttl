@prefix : <http://www.semanticweb.org/agencia/ontologies/viatges/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/agencia/ontologies/viatges/> .

<http://www.semanticweb.org/agencia/ontologies/viatges> rdf:type owl:Ontology .

### Classes Principals
:Usuari rdf:type owl:Class .
:Parella rdf:type owl:Class ; rdfs:subClassOf :Usuari .
:Familia rdf:type owl:Class ; rdfs:subClassOf :Usuari .
:GrupAmics rdf:type owl:Class ; rdfs:subClassOf :Usuari .
:ViatgerIndividual rdf:type owl:Class ; rdfs:subClassOf :Usuari .

:Viatge rdf:type owl:Class .
:ViatgeRomantic rdf:type owl:Class ; rdfs:subClassOf :Viatge .
:ViatgeCultural rdf:type owl:Class ; rdfs:subClassOf :Viatge .
:ViatgeDescans rdf:type owl:Class ; rdfs:subClassOf :Viatge .

:Ciutat rdf:type owl:Class .
:Atraccio rdf:type owl:Class .
:Allotjament rdf:type owl:Class .
:Hotel rdf:type owl:Class ; rdfs:subClassOf :Allotjament .
:Apartament rdf:type owl:Class ; rdfs:subClassOf :Allotjament .

:Mitja_de_Transport rdf:type owl:Class .

### Object Properties (Relacions)
:visita_ciutat rdf:type owl:ObjectProperty ; rdfs:domain :Viatge ; rdfs:range :Ciutat .
:inclou_atraccio rdf:type owl:ObjectProperty ; rdfs:domain :Ciutat ; rdfs:range :Atraccio .
:requereix_allotjament rdf:type owl:ObjectProperty ; rdfs:domain :Viatge ; rdfs:range :Allotjament .

### Data Properties (Atributs)
:pressupost_max rdf:type owl:DatatypeProperty ; rdfs:domain :Usuari ; rdfs:range xsd:integer .
:dies_disponibles rdf:type owl:DatatypeProperty ; rdfs:domain :Usuari ; rdfs:range xsd:integer .
:sacrifica_qualitat rdf:type owl:DatatypeProperty ; rdfs:domain :Usuari ; rdfs:range xsd:boolean .
:preu_estimat rdf:type owl:DatatypeProperty ; rdfs:domain :Viatge ; rdfs:range xsd:integer .
:tematica rdf:type owl:DatatypeProperty ; rdfs:domain :Ciutat ; rdfs:range xsd:string .